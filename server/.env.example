# 复制为 .env 后按需修改

# 监听地址与端口
HOST=127.0.0.1
PORT=8787

# 允许的前端来源（逗号分隔），* 表示不限制
CORS_ORIGIN=*

# 转发上游域名白名单（逗号分隔）。留空则使用内置默认列表
# ALLOWED_UPSTREAM_HOSTS=api.minimaxi.com,api.openai.com,generativelanguage.googleapis.com

# 放开上游白名单（仅建议本机自用）
ALLOW_ANY_UPSTREAM=0

# 单次生成请求超时（毫秒）
GENERATE_TIMEOUT_MS=180000

# 服务端托管的 API Key（前端不填时使用）。也可用 STUDIO_API_KEYS 一次性写全：
# STUDIO_API_KEYS={"minimax":"sk-xxx","openai":"sk-yyy"}
MINIMAX_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CUSTOM_API_KEY=

# 历史记录落盘目录（相对 server/ 目录）
DATA_DIR=data

# ---------- AI Agent（漫画助手）----------
# Agent 用一个 OpenAI 兼容的 chat/completions 端点：DeepSeek / 通义 / 智谱 / OpenAI 均可。
# 也可以留空，改在页面「AI 助手」面板里填（存浏览器 localStorage）。
AGENT_BASE_URL=https://api.deepseek.com
AGENT_PATH=/v1/chat/completions
AGENT_API_KEY=
AGENT_MODEL=deepseek-chat

# 复盘功能要把图喂给模型，需要支持视觉输入的模型；留空则复用 AGENT_MODEL
# AGENT_VISION_MODEL=gpt-4o

# 鉴权头（部分网关用 api-key 而不是 Authorization）
AGENT_AUTH_HEADER=Authorization
AGENT_AUTH_PREFIX="Bearer "

# 采样温度 / 单次最大输出 token / 超时（毫秒）
AGENT_TEMPERATURE=0.8
AGENT_MAX_TOKENS=4096
AGENT_TIMEOUT_MS=120000
