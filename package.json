{
  "name": "multi-vendor-image-studio",
  "private": true,
  "version": "1.0.0",
  "description": "多厂商图像生成工作台 · Vue 3 前端 + Node 后端",
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix web",
    "dev": "node scripts/dev.js",
    "dev:server": "npm run dev --prefix server",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "start": "npm run start --prefix server",
    "test": "npm test --prefix server"
  },
  "engines": {
    "node": ">=18.17"
  }
}
